# =============================================
# HireLoop Backend - Environment Variables
# =============================================
# Copy this file to ".env" and fill in real values.
# NEVER commit your actual .env file.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Local MongoDB example: mongodb://127.0.0.1:27017/hireloop
# MongoDB Atlas example: mongodb+srv://<user>:<password>@cluster.mongodb.net/hireloop
MONGODB_URI=mongodb://127.0.0.1:27017/hireloop

# --- JWT ---
# Use long, random strings in real deployments (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth ---
# Get these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- Frontend ---
# Used for CORS - set to your frontend's URL
FRONTEND_URL=http://localhost:3000

# --- Email (Nodemailer) ---
# If left blank, the backend logs emails to the console instead of sending
# them (safe default for local hackathon development).
# Example for Gmail: use an App Password, not your real password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=HireLoop <no-reply@hireloop.dev>

# --- Resume upload ---
MAX_RESUME_SIZE_MB=5

# --- AI service (optional, for Shivam's service to authenticate if needed) ---
AI_SERVICE_API_KEY=
